#!/bin/bash
#SBATCH --job-name=memos-calibrate-{{ platform.name }}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node={{ platform.gpus_per_node }}
#SBATCH --gres=gpu:{{ platform.gpus_per_node }}
#SBATCH --time={{ time }}
#SBATCH --exclusive
{% if nodelist %}#SBATCH --nodelist={{ nodelist }}
{% endif %}{% if account %}#SBATCH --account={{ account }}
{% endif %}{% if partition %}#SBATCH --partition={{ partition }}
{% endif %}#SBATCH --output={{ host_output_dir }}/calibrate-%j.log

set -euo pipefail

{% if container_image %}CONTAINER_ARGS="--container-image={{ container_image }}{% if container_mounts %} --container-mounts={{ container_mounts }}{% endif %} --no-container-mount-home"
{% else %}CONTAINER_ARGS=""
{% endif %}
OUTPUT_DIR={{ output_dir }}

echo "=== Setup ==="
srun --ntasks=1 $CONTAINER_ARGS bash -c "pip install -e {{ repo_dir }} --quiet && mkdir -p $OUTPUT_DIR"

echo "=== Phase 1: Per-node local probes ==="
srun --ntasks-per-node=1 --ntasks={{ nodes }} $CONTAINER_ARGS \
  memos _probe-node --output $OUTPUT_DIR/node_\${SLURM_NODEID}.json

echo "=== Phase 2: Cross-node NCCL bandwidth ==="
{% for key, val in platform.nccl_env.items() %}export {{ key }}={{ val }}
{% endfor %}srun --mpi=pmix --ntasks-per-node={{ platform.gpus_per_node }} $CONTAINER_ARGS \
  sendrecv_perf -b 8 -e {{ platform.nccl_max_bytes }} -f 2 -g 1 -c 1 -n 100 \
  > $OUTPUT_DIR/nccl_sendrecv.log 2>&1

srun --mpi=pmix --ntasks-per-node={{ platform.gpus_per_node }} $CONTAINER_ARGS \
  all_reduce_perf -b 8 -e {{ platform.nccl_max_bytes }} -f 2 -g 1 -c 1 -n 100 \
  > $OUTPUT_DIR/nccl_allreduce.log 2>&1

echo "=== Phase 3: Assemble ==="
srun --ntasks=1 $CONTAINER_ARGS \
  memos _assemble $OUTPUT_DIR --platform {{ platform.name }} \
  --output {{ final_output }}

echo "Done. Hardware YAML: {{ final_output }}"
