apiVersion: batch/v1
kind: Job
metadata:
  name: memos-run-{{ workload }}
{% if k8s_namespace %}  namespace: {{ k8s_namespace }}
{% endif %}spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
{% if nodelist_items %}      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values:
{% for node in nodelist_items %}                - {{ node }}
{% endfor %}{% endif %}      containers:
      - name: memos-run
        image: {{ image }}
        command:
        - /bin/bash
        - -c
        - |
          set -euo pipefail
{% for ev in env_vars %}          export {{ ev }}
{% endfor %}          pip install -e {{ repo_dir }} --quiet
          memos run {{ workload }} \
            --hw {{ hw_path }} \
            --model {{ model }} \
{% if tp %}            --tp {{ tp }} \
{% endif %}{% if input_tokens %}            --input-tokens "{{ input_tokens }}" \
{% endif %}{% if repeats %}            --repeats {{ repeats }} \
{% endif %}{% if batch and batch > 1 %}            --batch {{ batch }} \
{% endif %}{% if batch_mode and batch_mode != 'static' %}            --batch-mode {{ batch_mode }} \
{% endif %}{% if max_num_seqs %}            --max-num-seqs {{ max_num_seqs }} \
{% endif %}{% if cache_mode %}            --cache-mode {{ cache_mode }} \
{% endif %}{% if output_tokens %}            --output-tokens {{ output_tokens }} \
{% endif %}{% for ea in engine_args %}            --engine-arg {{ ea }} \
{% endfor %}            --output {{ output_dir }}
        resources:
          limits:
            nvidia.com/gpu: {{ gpus_per_node }}
          requests:
            nvidia.com/gpu: {{ gpus_per_node }}
        volumeMounts:
        - name: shmem
          mountPath: /dev/shm
        - name: memos-repo
          mountPath: {{ repo_dir }}
        - name: results
          mountPath: {{ output_dir }}
      volumes:
      - name: shmem
        hostPath:
          path: /dev/shm
      - name: memos-repo
        hostPath:
          path: {{ repo_dir }}
      - name: results
{% if pvc %}        persistentVolumeClaim:
          claimName: {{ pvc }}
{% else %}        emptyDir: {}
{% endif %}
