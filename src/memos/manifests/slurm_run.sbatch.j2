#!/bin/bash
#SBATCH --job-name=memos-run-{{ workload }}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:{{ gpus_per_node }}
#SBATCH --time={{ time }}
{% if nodelist %}#SBATCH --nodelist={{ nodelist }}
{% endif %}{% if account %}#SBATCH --account={{ account }}
{% endif %}{% if partition %}#SBATCH --partition={{ partition }}
{% endif %}{% for sa in slurm_args %}#SBATCH --{{ sa }}
{% endfor %}#SBATCH --output={{ host_output_dir }}/run-%j.log

set -euo pipefail

{% if container_image %}CONTAINER_ARGS="--container-image={{ container_image }}{% if container_mounts %} --container-mounts={{ container_mounts }}{% endif %} --no-container-mount-home"
{% else %}CONTAINER_ARGS=""
{% endif %}
srun $CONTAINER_ARGS bash -c "
{% for ev in env_vars %}  export {{ ev }}
{% endfor %}  pip install -e {{ repo_dir }} --quiet 2>/dev/null
  memos run {{ workload }} \
    --hw {{ hw_path }} \
    --model {{ model }} \
{% if tp %}    --tp {{ tp }} \
{% endif %}{% if input_tokens %}    --input-tokens '{{ input_tokens }}' \
{% endif %}{% if repeats %}    --repeats {{ repeats }} \
{% endif %}{% if cache_mode %}    --cache-mode {{ cache_mode }} \
{% endif %}{% if output_tokens %}    --output-tokens {{ output_tokens }} \
{% endif %}{% for ea in engine_args %}    --engine-arg {{ ea }} \
{% endfor %}    --output {{ output_dir }}
"
